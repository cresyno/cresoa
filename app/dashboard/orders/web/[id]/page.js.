import { createClient } from '@supabase/supabase-js'
import { notFound } from 'next/navigation'
import Link from 'next/link'

const supabaseAdmin = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY
)

export const dynamic = 'force-dynamic'

// Simple SVG icons for this server component
const BackArrow = () => (
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
)
const WhatsAppIcon = () => (
  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
)

export default async function WebsiteOrderDetail({ params, searchParams }) {
  const { id } = params
  const businessId = searchParams?.business_id || ''

  // Fetch the Website Order
  const { data: order, error } = await supabaseAdmin
    .from('public_orders')
    .select('*')
    .eq('id', id)
    .single()

  if (error || !order) {
    notFound()
  }

  const formatMoney = (val) => `₦${Number(val || 0).toLocaleString('en-NG')}`
  const formatDate = (date) => new Date(date).toLocaleDateString('en-NG', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })

  const isPaid = order.status === 'paid' || order.status === 'completed'
  
  // Clean phone for WhatsApp link
  let cleanPhone = (order.customer_phone || '').replace(/\D/g, '')
  if (cleanPhone.startsWith('0')) cleanPhone = '234' + cleanPhone.slice(1)
  const waText = encodeURIComponent(`Hello ${order.customer_name}, this is a message from Cresoa regarding your recent website order.`)
  const waLink = cleanPhone ? `https://wa.me/${cleanPhone}?text=${waText}` : null

  return (
    <div style={{ padding: '1rem', maxWidth: '640px', margin: '0 auto', minHeight: '100vh', background: '#F8F6F2', paddingBottom: '120px', fontFamily: 'system-ui, -apple-system, sans-serif' }}>
      
      {/* HEADER */}
      <div style={{ display: 'flex', alignItems: 'center', gap: '1rem', marginBottom: '1.5rem', paddingTop: '1rem' }}>
        <Link href={`/dashboard/orders?business_id=${businessId}`} style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', width: '40px', height: '40px', background: '#FFF', borderRadius: '50%', border: '1px solid #EAEAEA', color: '#0F2B4A', textDecoration: 'none', boxShadow: '0 2px 8px rgba(0,0,0,0.05)' }}>
          <BackArrow />
        </Link>
        <div>
          <p style={{ margin: 0, fontSize: '0.75rem', fontWeight: 800, color: '#D4AF37', textTransform: 'uppercase', letterSpacing: '1px' }}>Online Order</p>
          <h1 style={{ margin: 0, fontSize: '1.4rem', fontWeight: 800, color: '#0F2B4A' }}>Order Details</h1>
        </div>
      </div>

      <div style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>
        
        {/* STATUS BANNER */}
        <div style={{ background: isPaid ? '#E6F4EA' : '#FEF3C7', padding: '1.25rem', borderRadius: '16px', border: `1px solid ${isPaid ? '#A7F3D0' : '#FDE68A'}`, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <div>
            <p style={{ margin: 0, fontSize: '0.8rem', fontWeight: 700, color: isPaid ? '#065F46' : '#92400E', textTransform: 'uppercase' }}>Payment Status</p>
            <p style={{ margin: '4px 0 0 0', fontSize: '1.2rem', fontWeight: 800, color: isPaid ? '#137333' : '#B45309' }}>
              {isPaid ? 'Fully Paid' : 'Pending Payment'}
            </p>
          </div>
          <div style={{ fontSize: '1.4rem', fontWeight: 800, color: '#0F2B4A' }}>
            {formatMoney(order.total_amount)}
          </div>
        </div>

        {/* CUSTOMER CARD */}
        <div style={{ background: '#FFF', padding: '1.25rem', borderRadius: '16px', border: '1px solid #EAEAEA', boxShadow: '0 2px 8px rgba(0,0,0,0.02)' }}>
          <h2 style={{ fontSize: '0.8rem', fontWeight: 800, color: '#666', margin: '0 0 1rem 0', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Customer Information</h2>
          
          <div style={{ display: 'flex', flexDirection: 'column', gap: '0.5rem' }}>
            <p style={{ margin: 0, fontSize: '1.1rem', fontWeight: 800, color: '#0F2B4A' }}>{order.customer_name}</p>
            <p style={{ margin: 0, color: '#555', fontSize: '0.95rem' }}>{order.customer_phone || 'No phone number provided'}</p>
            <p style={{ margin: 0, color: '#555', fontSize: '0.95rem', lineHeight: 1.5 }}>{order.customer_address || 'No delivery address provided'}</p>
          </div>

          {waLink && (
            <a href={waLink} target="_blank" rel="noopener noreferrer" style={{ display: 'inline-flex', alignItems: 'center', gap: '6px', marginTop: '1rem', background: '#E6F4EA', color: '#137333', padding: '8px 16px', borderRadius: '8px', fontSize: '0.85rem', fontWeight: 700, textDecoration: 'none' }}>
              <WhatsAppIcon /> Message Customer
            </a>
          )}
        </div>

        {/* ITEMS CARD */}
        <div style={{ background: '#FFF', padding: '1.25rem', borderRadius: '16px', border: '1px solid #EAEAEA', boxShadow: '0 2px 8px rgba(0,0,0,0.02)' }}>
          <h2 style={{ fontSize: '0.8rem', fontWeight: 800, color: '#666', margin: '0 0 1rem 0', textTransform: 'uppercase', letterSpacing: '0.5px' }}>Items Ordered</h2>
          
          <div style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>
            {order.items?.map((item, idx) => (
              <div key={idx} style={{ display: 'flex', gap: '1rem', alignItems: 'center', borderBottom: idx !== order.items.length - 1 ? '1px solid #F0F0F0' : 'none', paddingBottom: idx !== order.items.length - 1 ? '1rem' : '0' }}>
                <div style={{ width: '56px', height: '56px', background: '#F9F9F9', borderRadius: '10px', overflow: 'hidden', flexShrink: 0, border: '1px solid #EAEAEA' }}>
                  {item.image_url ? (
                    <img src={item.image_url} alt={item.name} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
                  ) : (
                    <div style={{ display: 'flex', height: '100%', alignItems: 'center', justifyContent: 'center', fontSize: '0.65rem', color: '#CCC', textAlign: 'center', padding: '4px' }}>No Image</div>
                  )}
                </div>
                <div style={{ flex: 1 }}>
                  <p style={{ margin: '0 0 0.2rem 0', fontWeight: 700, color: '#0F2B4A', fontSize: '0.95rem' }}>{item.name}</p>
                  <p style={{ margin: 0, color: '#666', fontSize: '0.85rem' }}>Qty: {item.quantity}</p>
                </div>
                <div style={{ fontWeight: 800, color: '#0F2B4A', fontSize: '0.95rem' }}>
                  {formatMoney(item.price)}
                </div>
              </div>
            ))}
          </div>

          <div style={{ display: 'flex', justifyContent: 'space-between', marginTop: '1.5rem', paddingTop: '1rem', borderTop: '2px solid #0F2B4A' }}>
            <span style={{ fontSize: '1rem', fontWeight: 800, color: '#0F2B4A' }}>Total</span>
            <span style={{ fontSize: '1.2rem', fontWeight: 800, color: '#D4AF37' }}>{formatMoney(order.total_amount)}</span>
          </div>
        </div>

        {/* METADATA */}
        <div style={{ background: '#FFF', padding: '1.25rem', borderRadius: '16px', border: '1px solid #EAEAEA', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <span style={{ fontSize: '0.85rem', color: '#666', fontWeight: 600 }}>Order Date</span>
          <span style={{ fontSize: '0.85rem', color: '#0F2B4A', fontWeight: 700 }}>{formatDate(order.created_at)}</span>
        </div>

      </div>
    </div>
  )
}
